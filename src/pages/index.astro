---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import CtaSection from "../components/ui/CtaSection.astro";
---

<Layout title="Ethercraft Guild | Master Digital Craftsmanship">
  <!-- Hero Section -->
  <Section class="hero-section">
    <div class="hero-content">
      <h1 class="fade-in-up">
        Mastering Digital Craftsmanship: Custom Solutions from Ethercraft Guild
      </h1>
      <p class="value-prop fade-in-up delay-1">
        Your dedicated guild of globally-vetted specialists in Software
        Development, Digital Growth, and Strategic Operations.
      </p>

      <div class="cta-group fade-in-up delay-2">
        <Button href="/contact" variant="primary"
          >Start Your Project Consultation</Button
        >
      </div>

      <div class="trust-signals fade-in-up delay-3">
        <p>Trusted by industry leaders and startups alike.</p>
        <div class="logos">
          <!-- Placeholder simple text logos for now -->
          <span>TechCorp</span>
          <span>GrowthInc</span>
          <span>ScaleOps</span>
          <span>VentureFund</span>
        </div>
      </div>
    </div>
  </Section>

  <!-- Service Overview -->
  <Section class="services-section">
    <h2>Our Three Pillars of Craftsmanship</h2>
    <div class="card-grid">
      <Card>
        <div slot="icon" class="card-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect
              x="2"
              y="14"
              width="20"
              height="8"
              rx="2"
              ry="2"></rect><line x1="6" x2="6" y1="6" y2="6"></line><line
              x1="6"
              x2="6"
              y1="18"
              y2="18"></line></svg
          >
        </div>
        <h3 slot="title">Digital Architecture</h3>
        <p>
          Build, secure, and modernize your core platform with expert
          developers.
        </p>
        <div class="card-footer">
          <a href="/services/architecture" class="text-link"
            >Explore Architecture &rarr;</a
          >
        </div>
      </Card>

      <Card>
        <div slot="icon" class="card-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="m2 7 10-5 10 5v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7Z"
            ></path><path d="M12 22V12"></path><path d="M17 22v-5"></path><path
              d="M7 22v-5"></path></svg
          >
        </div>
        <h3 slot="title">Growth & Brand Mastery</h3>
        <p>
          Attract, engage, and convert your audience with data-driven content
          and marketing.
        </p>
        <div class="card-footer">
          <a href="/services/growth" class="text-link">Explore Growth &rarr;</a>
        </div>
      </Card>

      <Card>
        <div slot="icon" class="card-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle
              cx="8.5"
              cy="7"
              r="4"></circle><line x1="20" x2="20" y1="8" y2="14"></line><line
              x1="23"
              x2="17"
              y1="11"
              y2="11"></line></svg
          >
        </div>
        <h3 slot="title">Talent & Operational Support</h3>
        <p>
          Scale your operations and fill resource gaps with specialized, vetted
          talent.
        </p>
        <div class="card-footer">
          <a href="/services/operations" class="text-link"
            >Explore Operations &rarr;</a
          >
        </div>
      </Card>
    </div>
  </Section>

  <!-- Featured Case Study -->
  <Section class="case-study-section">
    <h2>Proof of Craftsmanship: Real-World Results</h2>
    <div class="case-study-container">
      <div class="case-snippet">
        <h3 class="highlight-stat">+40% Conversion Rate</h3>
        <p>
          Achieved for [Client Name] through a complete UX overhaul and
          performance optimization.
        </p>
        <Button href="/case-studies/client-name" variant="secondary"
          >View Case Study</Button
        >
      </div>
      <div class="testimonial">
        <blockquote>
          "Ethercraft Guild didn't just build a website; they engineered a
          growth engine. The attention to detail is unmatched."
        </blockquote>
        <cite>— CTO, Major FinTech Startup</cite>
      </div>
    </div>
  </Section>

  <!-- Closing CTA -->
  <CtaSection
    title="Ready to Partner with the Guild?"
    ctaText="Explore All Services"
    ctaLink="/services"
    variant="tertiary"
  />
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .value-prop {
    font-size: 1.25rem;
    color: var(--color-text);
    opacity: 0.9;
    margin-bottom: var(--space-lg);
  }

  .cta-group {
    margin-bottom: var(--space-2xl);
  }

  .trust-signals p {
    font-size: 0.875rem;
    opacity: 0.6;
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .logos {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    opacity: 0.5;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  /* Services */
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .card-footer {
    margin-top: var(--space-md);
  }

  .card-icon {
    margin-bottom: var(--space-sm);
    color: var(--color-text);
    opacity: 0.8;
  }

  h3[slot="title"] {
    margin-bottom: var(--space-xs);
  }

  .text-link {
    font-weight: 600;
    font-size: 0.9375rem;
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .text-link:hover {
    transform: translateX(4px);
    text-decoration: underline;
  }

  /* Case Study */
  .case-study-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    padding: var(--space-xl);
    border-radius: var(--radius-sm);
    margin-top: var(--space-lg);
  }

  .highlight-stat {
    font-size: 3rem;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .testimonial blockquote {
    font-size: 1.5rem;
    font-style: italic;
    margin-bottom: var(--space-md);
    line-height: 1.4;
  }

  .testimonial cite {
    font-weight: 600;
    font-style: normal;
  }

  /* Closing */
  .closing-content {
    text-align: center;
    background-color: var(--color-accent);
    color: #f7f7f7;
    padding: var(--space-2xl) var(--space-md);
    border-radius: var(--radius-sm);
  }

  .closing-content h3 {
    margin-bottom: var(--space-lg);
    color: #f7f7f7;
  }

  /* Animations */
  .fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  .delay-1 {
    animation-delay: 0.2s;
  }
  .delay-2 {
    animation-delay: 0.4s;
  }
  .delay-3 {
    animation-delay: 0.6s;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 768px) {
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }

    .case-study-container {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .hero-section {
      padding-top: var(--space-2xl);
    }
  }
</style>
