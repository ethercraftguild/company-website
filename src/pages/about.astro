---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
---

<Layout title="About Us | Ethercraft Guild">
  <!-- Hero -->
  <Section class="hero-section">
    <div class="hero-content">
        <h1>About Ethercraft Guild</h1>
        <p class="subtitle">Mastering Digital Craftsmanship</p>
    </div>
  </Section>

  <!-- Mission & Story -->
  <Section>
    <div class="split-layout">
        <div class="text-content">
            <h2>Our Mission</h2>
            <p>
                Ethercraft Guild is a professional web design and development company that specializes in creating high-quality, user-friendly websites for businesses and individuals. Our mission is to help our clients build a strong online presence and reach their full potential in the digital space.
            </p>
            <p>
                From the initial consultation to the final launch, we provide comprehensive services, including website design, content creation, search engine optimization, and ongoing maintenance and support.
            </p>
        </div>
        <div class="image-placeholder">
            <div class="placeholder-box">
                Team / Workspace Image
            </div>
        </div>
    </div>
  </Section>

  <!-- Our Approach -->
  <Section class="approach-section">
      <div class="container-sm">
        <h2>Custom Solutions, Global Talent</h2>
        <p>
            Our team of experienced designers and developers works closely with clients to create custom websites that meet their unique needs and goals. We believe in craftsmanship, not templates.
        </p>
        
        <div class="stats-grid">
            <div class="stat-item">
                <span class="stat-number">5+</span>
                <span class="stat-label">Years of Experience</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">50+</span>
                <span class="stat-label">Projects Delivered</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">100%</span>
                <span class="stat-label">Client Satisfaction</span>
            </div>
        </div>
      </div>
  </Section>

  <!-- Values -->
  <Section>
      <h2>Our Core Values</h2>
      <div class="values-grid">
          <Card title="Craftsmanship">
              <p>We take pride in our code. Every pixel is intentional, every interaction is smooth.</p>
          </Card>
          <Card title="Transparency">
              <p>No black boxes. We work openly with you, providing clear updates and honest advice.</p>
          </Card>
          <Card title="Performance">
              <p>We build for speed and scalability. Your success is our primary metric.</p>
          </Card>
      </div>
  </Section>

  <!-- CTA -->
  <Section class="closing-section">
      <h3>Ready to Build Something Great?</h3>
      <Button href="/contact" variant="primary">Work With Us</Button>
  </Section>

</Layout>

<style>
    .hero-section {
        background-color: var(--color-bg);
        text-align: center;
        padding-top: var(--space-2xl);
    }

    .hero-content h1 {
        margin-bottom: var(--space-xs);
    }

    .subtitle {
        font-family: var(--font-mono);
        color: var(--color-accent);
        opacity: 0.8;
    }

    .split-layout {
        display: grid;
        gap: var(--space-xl);
    }
    
    .text-content p {
        font-size: 1.125rem;
        margin-bottom: var(--space-md);
    }

    .image-placeholder {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .placeholder-box {
        width: 100%;
        height: 300px;
        background-color: #E5E5E5;
        border: 1px dashed var(--color-border);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text);
        opacity: 0.6;
        border-radius: var(--radius-sm);
    }

    .approach-section {
        background-color: #FFFFFF;
        text-align: center;
    }

    .container-sm {
        max-width: 800px;
        margin: 0 auto;
    }

    .stats-grid {
        display: flex;
        justify-content: space-around;
        margin-top: var(--space-xl);
        border-top: 1px solid var(--color-border);
        padding-top: var(--space-lg);
    }

    .stat-item {
        display: flex;
        flex-direction: column;
    }

    .stat-number {
        font-size: 3rem;
        font-weight: 700;
        color: var(--color-accent);
        line-height: 1;
    }

    .stat-label {
        margin-top: var(--space-xs);
        font-size: 0.875rem;
        opacity: 0.7;
        text-transform: uppercase;
    }

    .values-grid {
        display: grid;
        gap: var(--space-lg);
        grid-template-columns: 1fr;
        margin-top: var(--space-lg);
    }

    .closing-section {
        text-align: center;
        padding-bottom: var(--space-2xl);
    }

    .closing-section h3 {
        margin-bottom: var(--space-lg);
    }

    @media (min-width: 768px) {
        .split-layout {
            grid-template-columns: 1fr 1fr;
            align-items: center;
        }

        .values-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
