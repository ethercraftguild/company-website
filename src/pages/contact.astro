---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import { SITE_CONFIG } from '../config';

const formAction = `https://formspree.io/f/${SITE_CONFIG.contactEmail}`;
---

<Layout title="Contact Us | Ethercraft Guild">
  <Section class="contact-section">
    <div class="contact-card">
        <h1>Start Your Project</h1>
        <p class="subtitle">Tell us about your goals. We'll get back to you within 24 hours.</p>
        
        <div class="direct-contact top-contact">
            <a href={SITE_CONFIG.calendly} target="_blank" class="calendly-link primary">
                <span class="icon-calendar">📅</span> Schedule a 30-min Discovery
            </a>
            <p class="divider-text">OR</p>
        </div>

        <form action={formAction} method="POST" class="contact-form">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required placeholder="Jane Doe" />
          </div>
          
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="jane@company.com" />
          </div>
    
          <div class="form-group">
            <label for="message">Project Details</label>
            <textarea id="message" name="message" rows="5" required placeholder="I need help with..."></textarea>
          </div>
    
          <Button type="submit" variant="primary" class="submit-btn">Send Message</Button>
        </form>
        
        <div class="email-contact">
            <p class="small-text">Prefer email? <a href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a></p>
        </div>
    </div>
  </Section>
</Layout>

<style>
    .contact-section {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding-top: var(--space-xl);
    }
    
    .contact-card {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
    }
    
    h1 { margin-bottom: var(--space-xs); text-align: center; }
    .subtitle { text-align: center; margin-bottom: var(--space-xl); opacity: 0.8; }
    
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        margin-bottom: var(--space-xl);
    }
    
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .form-group label {
        font-size: 0.875rem;
        font-weight: 600;
    }
    
    .form-group input,
    .form-group textarea {
        padding: 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        font-family: inherit;
        font-size: 1rem;
        background: var(--color-bg);
    }
    
    .top-contact {
        text-align: center;
        margin-bottom: var(--space-lg);
    }

    .calendly-link.primary {
        background-color: var(--color-text);
        color: var(--color-bg);
        border: 1px solid var(--color-text);
        border-radius: 25px;
        padding: 12px 24px;
        font-size: 1.1rem;
    }
    
    .calendly-link.primary:hover {
        background-color: transparent;
        color: var(--color-text);
    }
    
    .divider-text {
        margin: var(--space-md) 0;
        font-size: 0.875rem;
        opacity: 0.5;
        font-weight: 600;
        position: relative;
    }
    
    .divider-text::before, .divider-text::after {
        content: '';
        display: inline-block;
        width: 30px;
        height: 1px;
        background-color: var(--color-border);
        vertical-align: middle;
        margin: 0 10px;
    }

    .email-contact {
        text-align: center;
        margin-top: var(--space-lg);
        opacity: 0.8;
    }
    
    .email-contact a {
        color: var(--color-text);
        text-decoration: underline;
    }
</style>
