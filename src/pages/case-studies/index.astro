---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
---

<Layout title="Case Studies | Ethercraft Guild">
  <Section class="intro">
    <h1>Our Case Studies</h1>
    <p>Real results from real projects.</p>
  </Section>

  <Section>
    <div class="grid">
        <Card title="FinTech Dashboard Overhaul">
            <p>Reduced user onboarding time by 40% with a streamlined Flutter interface.</p>
            <div style="margin-top: 1rem;">
                <a href="/case-studies/fintech-app" style="text-decoration: underline;">Read Full Study &rarr;</a>
            </div>
        </Card>
        <Card title="SaaS Platform Scale-Up">
            <p>How we helped a Client scale their Python backend to handle 10x traffic.</p>
            <div style="margin-top: 1rem;">
                <a href="/case-studies/client-name" style="text-decoration: underline;">Read Full Study &rarr;</a>
            </div>
        </Card>
    </div>
  </Section>
</Layout>

<style>
    .intro {
        text-align: center;
        padding-top: var(--space-2xl);
    }
    .grid {
        display: grid;
        gap: var(--space-lg);
        grid-template-columns: 1fr;
    }
    @media(min-width: 768px) {
        .grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>
