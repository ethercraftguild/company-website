---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
---

<Layout title="Growth & Brand Mastery | Ethercraft Guild">
  <Section class="hero">
    <h1>Growth & Brand Mastery</h1>
    <p>Attract, engage, and convert your audience with data-driven content and marketing.</p>
    <Button href="/contact" variant="primary">Start Growing</Button>
  </Section>
</Layout>

<style>
    .hero {
        text-align: center;
        padding-top: var(--space-2xl);
    }
    h1 { margin-bottom: var(--space-md); }
    p { margin-bottom: var(--space-lg); font-size: 1.25rem; }
</style>
