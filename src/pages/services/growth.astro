---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import Accordion from '../../components/ui/Accordion.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CtaSection from '../../components/ui/CtaSection.astro';
---

<Layout title="Growth & Brand Mastery | Ethercraft Guild">
  
  <PageHero 
    title="Growth & Brand Mastery" 
    subtitle="We build brands that resonate and strategies that convert. Data-driven growth for the modern digital landscape."
    ctaText="Audit Your Strategy"
    ctaLink="/contact"
  />

  <Section class="service-index">
    <h2>Specializations</h2>
    <div class="accordion-wrapper">
        <Accordion items={[
            {
                title: "SEO & Content Strategy",
                description: "Drive organic traffic with high-value content architecture and technical SEO. We build authority that lasts, not just temporary spikes."
            },
            {
                title: "Brand Identity & Design",
                description: "Forge a distinct visual and verbal identity. From logo systems to voice guidelines, we ensure your brand cuts through the noise."
            },
            {
                title: "Performance Marketing",
                description: "Paid acquisition campaigns that respect ROI. We manage ad spend across Google, LinkedIn, and Meta with a focus on CAC and LTV."
            }
        ]} />
    </div>
  </Section>

  <Section class="why-choose">
    <div class="why-header">
        <h2>The Guild Difference</h2>
    </div>
    <div class="feature-grid">
        <div class="feature-item">
            <div class="feature-icon">📊</div>
            <h3>Data, Not Gut Feeling</h3>
            <p>Every campaign is backed by analytics. We iterate based on what the numbers say.</p>
        </div>
        <div class="feature-item">
            <div class="feature-icon">🎨</div>
            <h3>Cohesive Storytelling</h3>
            <p>Design and copy work in unison. No disjointed messages across your channels.</p>
        </div>
        <div class="feature-item">
            <div class="feature-icon">🚀</div>
            <h3>Full-Funnel Ownership</h3>
            <p>From awareness to retention, we optimize the entire user journey.</p>
        </div>
    </div>
  </Section>

  <CtaSection 
    title="Ready to Scale?" 
    ctaText="Start Your Growth Project" 
    ctaLink="/contact" 
    variant="tertiary" 
  />

</Layout>

<style>
  .accordion-wrapper {
    max-width: 800px;
    margin-top: var(--space-lg);
  }

  .why-choose {
    background-color: #FFFFFF;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .feature-item {
      padding: var(--space-md);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
  }

  .feature-item h3 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-xs);
    font-size: 1.25rem;
  }

  .feature-icon {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
  }

  @media (min-width: 768px) {
    .feature-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
    
    .feature-item {
        border: none;
        padding: 0;
    }
  }
</style>
