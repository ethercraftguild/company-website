---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Section from '../../../components/ui/Section.astro';
import CtaSection from '../../../components/ui/CtaSection.astro';
---

<Layout title="Security & Audits | Ethercraft Guild">
  <PageHero 
    title="Security & Code Audits" 
    subtitle="Identify vulnerabilities before they become liabilities. Comprehensive security assessments for your digital assets."
    ctaText="Secure Your Infrastructure"
    ctaLink="/contact"
  />

  <Section class="service-details">
    <div class="content-grid">
      <div class="main-content">
        <h2>Protecting Your Digital Estate</h2>
        <p>Security is not a feature; it's a foundation. We perform rigorous audits of your codebase, infrastructure, and compliance posture to ensure you are protected against modern threats.</p>
        
        <h3>Our Audit Process</h3>
        <p>We go beyond automated scans using manual penetration testing and logical analysis:</p>
        
        <div class="capabilities-grid">
           <div class="cap-card">
              <h4>Code Review</h4>
              <p>Line-by-line analysis of your source code to find logic errors and insecure patterns.</p>
           </div>
           <div class="cap-card">
              <h4>Penetration Testing</h4>
              <p>Simulating real-world attacks to test your defenses against SQLi, XSS, and more.</p>
           </div>
           <div class="cap-card">
              <h4>Cloud Config</h4>
              <p>Reviewing AWS/GCP/Azure IAM roles and network policies for least-privilege access.</p>
           </div>
        </div>

        <h3>Compliance Readiness</h3>
        <p>We help prepare your engineering team for major compliance certifications:</p>
        <ul>
            <li>SOC 2 Type I & II Preparation</li>
            <li>GDPR Data Privacy Impact Assessments</li>
            <li>HIPAA Compliance for HealthTech</li>
        </ul>
      </div>
      
      <aside class="sidebar">
        <div class="info-card">
            <h4>Scope of Work</h4>
            <ul class="process-list">
                <li>Initial Discovery</li>
                <li>Automated Scanning</li>
                <li>Manual Exploitation</li>
                <li>Reporting & Remediation</li>
                <li>Re-verification</li>
            </ul>
        </div>
      </aside>
    </div>
  </Section>

  <CtaSection 
    title="Don't Wait for a Breach" 
    ctaText="Schedule an Audit" 
    ctaLink="/contact"
    variant="tertiary" 
  />
  
</Layout>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  h2 { margin-bottom: var(--space-md); }
  h3 { margin-top: var(--space-lg); margin-bottom: var(--space-sm); font-size: 1.5rem; }
  p { margin-bottom: var(--space-md); line-height: 1.6; }
  
  ul {
      list-style: disc;
      margin-left: var(--space-lg);
      margin-bottom: var(--space-md);
  }
  
  li { margin-bottom: var(--space-xs); }

  .capabilities-grid {
      display: grid;
      gap: var(--space-md);
      margin-top: var(--space-md);
  }
  
  .cap-card {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      padding: var(--space-md);
      border-radius: var(--radius-sm);
  }
  
  .cap-card h4 { margin-bottom: var(--space-xs); }
  .cap-card p { margin-bottom: 0; font-size: 0.9rem; opacity: 0.8; }

  .info-card {
      background-color: var(--color-text); /* Black bg */
      color: var(--color-bg); /* White text */
      padding: var(--space-lg);
      border-radius: var(--radius-sm);
  }
  
  .info-card h4 {
      color: var(--color-bg);
      border-bottom: 1px solid rgba(255,255,255,0.2);
      padding-bottom: var(--space-sm);
      margin-bottom: var(--space-md);
  }
  
  .process-list {
      list-style: none;
      margin: 0;
      padding: 0;
  }
  
  .process-list li {
      padding: var(--space-xs) 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  .process-list li:last-child { border: none; }

  @media (min-width: 768px) {
    .content-grid {
      grid-template-columns: 2fr 1fr;
    }
    
    .capabilities-grid {
        grid-template-columns: 1fr 1fr;
    }
  }
</style>
