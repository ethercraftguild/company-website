---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Section from '../../../components/ui/Section.astro';
import CtaSection from '../../../components/ui/CtaSection.astro';
---

<Layout title="Web Platform Development | Ethercraft Guild">
  <PageHero 
    title="Web Platform Development" 
    subtitle="Enterprise-grade web applications built for speed, scalability, and seamless user experiences."
    ctaText="Build Your Platform"
    ctaLink="/contact"
  />

  <Section class="service-details">
    <div class="content-grid">
      <div class="main-content">
        <h2>Modern Web Solutions</h2>
        <p>In a digital-first world, your web platform is your headquarters. We build robust, high-performance web applications that serve as the engine of your business.</p>
        
        <h3>Our Stack</h3>
        <p>We leverage modern frameworks to deliver lightning-fast experiences:</p>
        <ul>
          <li><strong>Frontend:</strong> React, Vue, Svelte, Astro</li>
          <li><strong>Backend:</strong> Node.js, Python (Django/FastAPI), Go</li>
          <li><strong>Infrastructure:</strong> AWS, Google Cloud, Vercel</li>
        </ul>

        <h3>What We Build</h3>
        <div class="capabilities-grid">
           <div class="cap-card">
              <h4>SaaS products</h4>
              <p>Multi-tenant architectures with subscription billing and complex access controls.</p>
           </div>
           <div class="cap-card">
              <h4>Internal Tools</h4>
              <p>Custom dashboards and admin panels that streamline your operations.</p>
           </div>
           <div class="cap-card">
              <h4>E-Commerce</h4>
              <p>Headless commerce solutions that offer limitless customization and speed.</p>
           </div>
        </div>
      </div>
      
      <aside class="sidebar">
        <div class="info-card">
            <h4>Development Cycle</h4>
            <ul class="process-list">
                <li>Discovery & Architecture</li>
                <li>UI/UX Design</li>
                <li>Agile Development</li>
                <li>QA & Testing</li>
                <li>Deployment & DevOps</li>
            </ul>
        </div>
      </aside>
    </div>
  </Section>

  <CtaSection 
    title="Ready to Build?" 
    ctaText="Schedule Technical Discovery" 
    ctaLink="/contact"
    variant="tertiary" 
  />
  
</Layout>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  h2 { margin-bottom: var(--space-md); }
  h3 { margin-top: var(--space-lg); margin-bottom: var(--space-sm); font-size: 1.5rem; }
  p { margin-bottom: var(--space-md); line-height: 1.6; }
  
  ul {
      list-style: disc;
      margin-left: var(--space-lg);
      margin-bottom: var(--space-md);
  }
  
  li { margin-bottom: var(--space-xs); }

  .capabilities-grid {
      display: grid;
      gap: var(--space-md);
      margin-top: var(--space-md);
  }
  
  .cap-card {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      padding: var(--space-md);
      border-radius: var(--radius-sm);
  }
  
  .cap-card h4 { margin-bottom: var(--space-xs); }
  .cap-card p { margin-bottom: 0; font-size: 0.9rem; opacity: 0.8; }

  .info-card {
      background-color: var(--color-text); /* Black bg */
      color: var(--color-bg); /* White text */
      padding: var(--space-lg);
      border-radius: var(--radius-sm);
  }
  
  .info-card h4 {
      color: var(--color-bg);
      border-bottom: 1px solid rgba(255,255,255,0.2);
      padding-bottom: var(--space-sm);
      margin-bottom: var(--space-md);
  }
  
  .process-list {
      list-style: none;
      margin: 0;
      padding: 0;
  }
  
  .process-list li {
      padding: var(--space-xs) 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  .process-list li:last-child { border: none; }

  @media (min-width: 768px) {
    .content-grid {
      grid-template-columns: 2fr 1fr;
    }
    
    .capabilities-grid {
        grid-template-columns: 1fr 1fr;
    }
  }
</style>
