---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Section from '../../../components/ui/Section.astro';
import CtaSection from '../../../components/ui/CtaSection.astro';
---

<Layout title="Performance Marketing | Ethercraft Guild">
  <PageHero 
    title="Performance Marketing" 
    subtitle="Maximize ROAS with scientific campaign management. We manage paid acquisition across search, social, and display."
    ctaText="Launch Campaign"
    ctaLink="/contact"
  />

  <Section class="service-details">
    <div class="content-grid">
      <div class="main-content">
        <h2>Acquisition at Scale</h2>
        <p>Stop wasting budget on vanity metrics. We focus on Customer Acquisition Cost (CAC) and Lifetime Value (LTV) to ensure efficient growth.</p>
        
        <h3>Channel Expertise</h3>
        <p>We deploy budget where your audience lives:</p>
        
        <div class="capabilities-grid">
           <div class="cap-card">
              <h4>Google Ads</h4>
              <p>High-intent capture via Search and Shopping campaigns. Dominate the keywords that signal purchase readiness.</p>
           </div>
           <div class="cap-card">
              <h4>LinkedIn Ads</h4>
              <p>Precision targeting for B2B. Reach decision-makers by job title, company size, and industry.</p>
           </div>
           <div class="cap-card">
              <h4>Meta (FB/IG)</h4>
              <p>Demand generation via powerful creative and algorithmic targeting.</p>
           </div>
        </div>

        <h3>Analytics & Attribution</h3>
        <p>We set up robust conversion tracking (GA4, GTM, Server-side API) to ensure we know exactly which dollar drove which result.</p>
      </div>
      
      <aside class="sidebar">
        <div class="info-card">
            <h4>Campaign Services</h4>
            <ul class="process-list">
                <li>Audience Segmentation</li>
                <li>Creative Testing (A/B)</li>
                <li>Landing Page Optimization</li>
                <li>Remarketing Strategy</li>
                <li>Real-time Dashboards</li>
            </ul>
        </div>
      </aside>
    </div>
  </Section>

  <CtaSection 
    title="Ready for ROI?" 
    ctaText="Get a Campaign Audit" 
    ctaLink="/contact"
    variant="tertiary" 
  />
  
</Layout>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  h2 { margin-bottom: var(--space-md); }
  h3 { margin-top: var(--space-lg); margin-bottom: var(--space-sm); font-size: 1.5rem; }
  p { margin-bottom: var(--space-md); line-height: 1.6; }

  .capabilities-grid {
      display: grid;
      gap: var(--space-md);
      margin-top: var(--space-md);
  }
  
  .cap-card {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      padding: var(--space-md);
      border-radius: var(--radius-sm);
  }
  
  .cap-card h4 { margin-bottom: var(--space-xs); }
  .cap-card p { margin-bottom: 0; font-size: 0.9rem; opacity: 0.8; }

  .info-card {
      background-color: var(--color-text); 
      color: var(--color-bg);
      padding: var(--space-lg);
      border-radius: var(--radius-sm);
  }
  
  .info-card h4 {
      color: var(--color-bg);
      border-bottom: 1px solid rgba(255,255,255,0.2);
      padding-bottom: var(--space-sm);
      margin-bottom: var(--space-md);
  }
  
  .process-list {
      list-style: none;
      margin: 0;
      padding: 0;
  }
  
  .process-list li {
      padding: var(--space-xs) 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  .process-list li:last-child { border: none; }

  @media (min-width: 768px) {
    .content-grid {
      grid-template-columns: 2fr 1fr;
    }
    
    .capabilities-grid {
        grid-template-columns: 1fr 1fr;
    }
  }
</style>
