---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Section from '../../../components/ui/Section.astro';
import CtaSection from '../../../components/ui/CtaSection.astro';
---

<Layout title="SEO & Content Strategy | Ethercraft Guild">
  <PageHero 
    title="SEO & Content Strategy" 
    subtitle="Build sustainable organic growth. We create technical SEO foundations and content architectures that map to user intent."
    ctaText="Start Your Audit"
    ctaLink="/contact"
  />

  <Section class="service-details">
    <div class="content-grid">
      <div class="main-content">
        <h2>Content That Ranks and Converts</h2>
        <p>Ranking on the first page isn't enough; you need to answer the user's question better than anyone else. Our approach combines technical precision with editorial excellence.</p>
        
        <h3>Our Methodology</h3>
        <p>We don't guess. We use data to identify gaps in the market and fill them with authoritative content.</p>
        
        <div class="capabilities-grid">
           <div class="cap-card">
              <h4>Technical SEO</h4>
              <p>Core Web Vitals, schema markup, crawl budget optimization, and site structure.</p>
           </div>
           <div class="cap-card">
              <h4>Topic Clusters</h4>
              <p>Building pillar pages and supporting clusters to establish topical authority.</p>
           </div>
           <div class="cap-card">
              <h4>Content Production</h4>
              <p>High-fidelity articles, whitepapers, and guides written by subject matter experts.</p>
           </div>
        </div>

        <h3>Tools We Use</h3>
        <ul>
            <li>Ahrefs & SEMrush for competitive intelligence</li>
            <li>Google Search Console for performance tracking</li>
            <li>Clearscope / SurferSEO for content optimization</li>
        </ul>
      </div>
      
      <aside class="sidebar">
        <div class="info-card">
            <h4>Deliverables</h4>
            <ul class="process-list">
                <li>Technical Audit Report</li>
                <li>Keyword Strategy & Roadmap</li>
                <li>Content Calendar</li>
                <li>On-Page Optimization</li>
                <li>Monthly Reporting</li>
            </ul>
        </div>
      </aside>
    </div>
  </Section>

  <CtaSection 
    title="Dominate Search Results" 
    ctaText="Get a Strategy Session" 
    ctaLink="/contact"
    variant="tertiary" 
  />
  
</Layout>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  h2 { margin-bottom: var(--space-md); }
  h3 { margin-top: var(--space-lg); margin-bottom: var(--space-sm); font-size: 1.5rem; }
  p { margin-bottom: var(--space-md); line-height: 1.6; }
  
  ul {
      list-style: disc;
      margin-left: var(--space-lg);
      margin-bottom: var(--space-md);
  }
  
  li { margin-bottom: var(--space-xs); }

  .capabilities-grid {
      display: grid;
      gap: var(--space-md);
      margin-top: var(--space-md);
  }
  
  .cap-card {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      padding: var(--space-md);
      border-radius: var(--radius-sm);
  }
  
  .cap-card h4 { margin-bottom: var(--space-xs); }
  .cap-card p { margin-bottom: 0; font-size: 0.9rem; opacity: 0.8; }

  .info-card {
      background-color: var(--color-text); 
      color: var(--color-bg);
      padding: var(--space-lg);
      border-radius: var(--radius-sm);
  }
  
  .info-card h4 {
      color: var(--color-bg);
      border-bottom: 1px solid rgba(255,255,255,0.2);
      padding-bottom: var(--space-sm);
      margin-bottom: var(--space-md);
  }
  
  .process-list {
      list-style: none;
      margin: 0;
      padding: 0;
  }
  
  .process-list li {
      padding: var(--space-xs) 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  .process-list li:last-child { border: none; }

  @media (min-width: 768px) {
    .content-grid {
      grid-template-columns: 2fr 1fr;
    }
    
    .capabilities-grid {
        grid-template-columns: 1fr 1fr;
    }
  }
</style>
