---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Section from '../../../components/ui/Section.astro';
import CtaSection from '../../../components/ui/CtaSection.astro';
---

<Layout title="Process Optimization | Ethercraft Guild">
  <PageHero 
    title="Process Optimization" 
    subtitle="Eliminate bottlenecks and shipping delays. We engineer your workflows just like we engineer code."
    ctaText="Optimize Workflow"
    ctaLink="/contact"
  />

  <Section class="service-details">
    <div class="content-grid">
      <div class="main-content">
        <h2>Operational Excellence</h2>
        <p>Your team's output is limited by their environment. We analyze your delivery pipeline, communication structures, and tooling to unlock maximum velocity.</p>
        
        <h3>Areas of Focus</h3>
        <div class="capabilities-grid">
           <div class="cap-card">
              <h4>DevOps & CI/CD</h4>
              <p>Automating tests, builds, and deployments to achieve daily shipping cadence.</p>
           </div>
           <div class="cap-card">
              <h4>Agile Maturity</h4>
              <p>Moving from "doing Scrum" to truly being agile. Improving retro quality and sprint planning.</p>
           </div>
           <div class="cap-card">
              <h4>Tool Consolidation</h4>
              <p>Cleaning up your SaaS sprawl (Jira, Notion, Slack) to reduce context switching.</p>
           </div>
        </div>

        <h3>The "Guild" Standard</h3>
        <p>We believe in high-agency environments. Our optimization process focuses on empowering individual contributors by removing bureaucratic blockers.</p>
      </div>
      
      <aside class="sidebar">
        <div class="info-card">
            <h4>Optimization Outcomes</h4>
            <ul class="process-list">
                <li>Higher Deployment Frequency</li>
                <li>Lower Change Failure Rate</li>
                <li>Reduced Meeting Load</li>
                <li>Improved Documentation</li>
                <li>Clearer Ownership Maps</li>
            </ul>
        </div>
      </aside>
    </div>
  </Section>

  <CtaSection 
    title="Stop Fighting Fire" 
    ctaText="Fix Your Process" 
    ctaLink="/contact"
    variant="tertiary" 
  />
  
</Layout>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  h2 { margin-bottom: var(--space-md); }
  h3 { margin-top: var(--space-lg); margin-bottom: var(--space-sm); font-size: 1.5rem; }
  p { margin-bottom: var(--space-md); line-height: 1.6; }

  .capabilities-grid {
      display: grid;
      gap: var(--space-md);
      margin-top: var(--space-md);
  }
  
  .cap-card {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      padding: var(--space-md);
      border-radius: var(--radius-sm);
  }
  
  .cap-card h4 { margin-bottom: var(--space-xs); }
  .cap-card p { margin-bottom: 0; font-size: 0.9rem; opacity: 0.8; }

  .info-card {
      background-color: var(--color-text); 
      color: var(--color-bg);
      padding: var(--space-lg);
      border-radius: var(--radius-sm);
  }
  
  .info-card h4 {
      color: var(--color-bg);
      border-bottom: 1px solid rgba(255,255,255,0.2);
      padding-bottom: var(--space-sm);
      margin-bottom: var(--space-md);
  }
  
  .process-list {
      list-style: none;
      margin: 0;
      padding: 0;
  }
  
  .process-list li {
      padding: var(--space-xs) 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  .process-list li:last-child { border: none; }

  @media (min-width: 768px) {
    .content-grid {
      grid-template-columns: 2fr 1fr;
    }
    
    .capabilities-grid {
        grid-template-columns: 1fr 1fr;
    }
  }
</style>
