---
import { NAV_MENU } from '../config';
const currentPath = Astro.url.pathname;

// Helper to check if a link or its children are active
const isLinkActive = (item: any) => {
    if (item.href === currentPath) return true;
    if (item.children) {
        return item.children.some((child: any) => child.href === currentPath);
    }
    return false;
};
---

<div id="mobile-drawer" class="mobile-drawer" inert>
  <div class="drawer-overlay" id="drawer-overlay"></div>
  <div class="drawer-content">
    <div class="drawer-header">
      <h3>Ethercraft Guild</h3>
      <button id="close-drawer" class="close-btn" aria-label="Close menu">&times;</button>
    </div>
    
    <nav class="drawer-nav">
      <ul class="nav-list">
        {NAV_MENU.map((item) => {
            const isActive = isLinkActive(item);
            const hasChildren = item.children && item.children.length > 0;
            
            return (
                <li class={`nav-item ${isActive ? 'active' : ''}`}>
                    <div class="nav-row">
                        <a href={item.href} class="nav-link">
                            {isActive && <span class="active-dot"></span>}
                            {item.label}
                        </a>
                        {hasChildren && (
                            <button class="accordion-toggle" aria-label={`Toggle ${item.label} menu`}>
                                <span class="icon-plus">+</span>
                                <span class="icon-close">&times;</span>
                            </button>
                        )}
                    </div>
                    {hasChildren && (
                        <ul class="sub-menu">
                            {item.children.map((child: any) => {
                                const isChildActive = child.href === currentPath;
                                return (
                                    <li>
                                        <a href={child.href} class={`sub-link ${isChildActive ? 'child-active' : ''}`}>
                                            {child.label}
                                        </a>
                                    </li>
                                );
                            })}
                        </ul>
                    )}
                </li>
            );
        })}
      </ul>
    </nav>

    <div class="drawer-footer">
        <ul class="secondary-links">
            <li><a href="/privacy" target="_blank">Privacy Policy</a></li>
            <li><a href="/about" target="_blank">About Us</a></li>
            <li><a href="/terms" target="_blank">Terms & Conditions</a></li>
        </ul>
    </div>
  </div>
</div>

<style>
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000; /* Higher than header's 1000 */
    pointer-events: none;
    display: none; 
  }

  .mobile-drawer.is-open {
    display: block;
    pointer-events: auto;
  }

  .drawer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .mobile-drawer.is-open .drawer-overlay {
    opacity: 1;
  }

  .drawer-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    max-height: 85vh; /* Prevent overflowing screen height */
    overflow-y: auto; /* Allow internal scrolling if menu is tall */
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) var(--space-md);
    transform: translateY(100%);
    transition: transform var(--transition-fast);
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
  }

  .mobile-drawer.is-open .drawer-content {
    transform: translateY(0);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
    flex-shrink: 0;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 var(--space-sm);
  }

  .drawer-nav {
      flex-grow: 1;
      margin-bottom: var(--space-xl);
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .nav-item {
      border-bottom: 1px solid rgba(0,0,0,0.05); /* Subtle divider */
  }

  .nav-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
  }

  .nav-link {
    font-size: 1.25rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: var(--space-sm) 0;
    color: var(--color-text);
  }

  .active-dot {
      width: 8px;
      height: 8px;
      background-color: var(--color-text);
      border-radius: 50%;
      display: inline-block;
  }
  
  /* Accordion Toggle */
  .accordion-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
  }
  
  .icon-plus, .icon-close {
      position: absolute;
      font-size: 1.2rem;
      line-height: 1;
      transition: opacity 0.2s, transform 0.2s;
  }
  
  /* Default State: Collapsed */
  .icon-close {
      opacity: 0;
      transform: rotate(-90deg);
  }
  
  /* Active State (expanded via JS) */
  .nav-item.expanded .icon-plus {
      opacity: 0;
      transform: rotate(90deg);
  }
  
  .nav-item.expanded .icon-close {
      opacity: 1;
      transform: rotate(0);
  }
  
  /* Submenu */
  .sub-menu {
      list-style: none;
      padding-left: 20px;
      overflow: hidden;
      max-height: 0; 
      transition: max-height 0.3s ease-out;
  }
  
  .nav-item.expanded .sub-menu {
      max-height: 300px; /* Arbitrary large height */
      margin-bottom: var(--space-sm);
  }
  
  .sub-link {
      display: block;
      padding: 8px 0;
      font-size: 1rem;
      opacity: 0.7;
  }
  
  .child-active {
      opacity: 1;
      font-weight: 600;
      text-decoration: underline;
  }

  /* Footer Links */
  .drawer-footer {
      border-top: 1px solid var(--color-border);
      padding-top: var(--space-md);
      flex-shrink: 0;
  }
  
  .secondary-links {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between; /* Justify space between items */
      gap: var(--space-md);
  }
  
  .secondary-links a {
      font-size: 0.600rem;
      color: #999; /* Gray/Faded */
      text-decoration: none;
  }

  /* Desktop hidden */
  @media (min-width: 768px) {
    .mobile-drawer {
      display: none !important;
    }
  }
</style>

<script>
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const closeBtn = document.getElementById('close-drawer');
  const toggles = document.querySelectorAll('.accordion-toggle');

  function closeDrawer() {
    if (drawer) {
        drawer.classList.remove('is-open');
        drawer.setAttribute('inert', '');
        document.body.style.overflow = '';
    }
  }

  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (overlay) overlay.addEventListener('click', closeDrawer);
  
  // Accordion Logic
  toggles.forEach(toggle => {
      toggle.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLElement;
          const navItem = btn.closest('.nav-item');
          if (navItem) {
              navItem.classList.toggle('expanded');
          }
      });
  });
  
  // Expose to window for Header
  window.openDrawer = function() {
    if (drawer) {
        drawer.classList.add('is-open');
        drawer.removeAttribute('inert');
        document.body.style.overflow = 'hidden';
    }
  }
</script>
