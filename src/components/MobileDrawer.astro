---
<div id="mobile-drawer" class="mobile-drawer" inert>
  <div class="drawer-overlay" id="drawer-overlay"></div>
  <div class="drawer-content">
    <div class="drawer-header">
      <h3>Menu</h3>
      <button id="close-drawer" class="close-btn" aria-label="Close menu">&times;</button>
    </div>
    <nav class="drawer-nav">
      <ul>
        <li><a href="/services/architecture">Digital Architecture</a></li>
        <li><a href="/services/growth">Growth & Brand</a></li>
        <li><a href="/services/operations">Talent & Operations</a></li>
        <li><a href="/case-studies">Case Studies</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    pointer-events: none;
    display: none; /* Hidden by default */
  }

  .mobile-drawer.is-open {
    display: block;
    pointer-events: auto;
  }

  .drawer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .mobile-drawer.is-open .drawer-overlay {
    opacity: 1;
  }

  .drawer-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) var(--space-md);
    transform: translateY(100%);
    transition: transform var(--transition-fast);
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
  }

  .mobile-drawer.is-open .drawer-content {
    transform: translateY(0);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 var(--space-sm);
  }

  .drawer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .drawer-nav a {
    font-size: 1.25rem;
    font-weight: 600;
    display: block;
    padding: var(--space-sm) 0;
  }

  /* Desktop hidden */
  @media (min-width: 768px) {
    .mobile-drawer {
      display: none !important;
    }
  }
</style>

<script>
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const closeBtn = document.getElementById('close-drawer');
  // Open button logic will be in Header.astro

  function closeDrawer() {
    if (drawer) {
        drawer.classList.remove('is-open');
        drawer.setAttribute('inert', '');
        document.body.style.overflow = '';
    }
  }

  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (overlay) overlay.addEventListener('click', closeDrawer);
  
  // Expose to window for Header to use
  window.openDrawer = function() {
    if (drawer) {
        drawer.classList.add('is-open');
        drawer.removeAttribute('inert');
        document.body.style.overflow = 'hidden';
    }
  }
</script>
