---
import { Image } from "astro:assets";
import Logo from "../svgs/logo.svg";
import SocialIcons from "./ui/SocialIcons.astro";
import { SITE_CONFIG } from "../config";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand-link">
          <Image src={Logo} alt="Ethercraft Guild" width="98" height="98" />
          <span class="brand-text">{SITE_CONFIG.companyName}</span>
        </a>
        <!-- <p class="tagline">Mastering Digital Craftsmanship.</p> -->
        <SocialIcons class="footer-socials" />
      </div>
      <div class="footer-links">
        <div class="link-group">
          <h4>Services</h4>
          <ul>
            <li><a href="/services/architecture">Digital Architecture</a></li>
            <li><a href="/services/growth">Growth & Brand</a></li>
            <li><a href="/services/operations">Talent & Operations</a></li>
          </ul>
        </div>
        <div class="link-group">
          <h4>Company</h4>
          <ul>
            <li><a href="/about" target="_blank">About</a></li>
            <li><a href="/privacy" target="_blank">Privacy Policy</a></li>
            <li><a href="/terms" target="_blank">Terms & Conditions</a></li>
            <li><a href="/contact" target="_blank">Contact</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        &copy; {new Date().getFullYear()} Ethercraft Guild. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding: var(--space-xl) 0 var(--space-md);
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .footer-brand h3 {
    margin-bottom: var(--space-xs);
  }

  .footer-brand p {
    color: var(--color-text);
    opacity: 0.8;
  }

  .footer-socials {
    margin-top: var(--space-md);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .footer-socials {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .brand-text {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: -0.05em;
  }

  .tagline {
    font-size: 1rem;
    font-weight: 600;
    opacity: 0.6;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-bg);
    text-decoration: none;
    margin-bottom: var(--space-sm);
  }

  .link-group h4 {
    font-size: 1rem;
    margin-bottom: var(--space-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .link-group ul {
    list-style: none;
  }

  .link-group li {
    margin-bottom: var(--space-sm);
  }

  .link-group a {
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .link-group a:hover {
    text-decoration: underline;
    opacity: 0.7;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
    text-align: center;
    font-size: 0.875rem;
    opacity: 0.6;
  }

  @media (min-width: 768px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
    }

    .footer-links {
      gap: var(--space-2xl);
    }
  }
</style>
