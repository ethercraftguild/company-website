---
import MobileDrawer from './MobileDrawer.astro';
import Button from './ui/Button.astro';
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand">
      <span class="brand-text">Ethercraft Guild</span>
    </a>

    <nav class="desktop-nav">
      <ul>
        <li><a href="/services/architecture">Architecture</a></li>
        <li><a href="/services/growth">Growth</a></li>
        <li><a href="/services/operations">Operations</a></li>
        <li><a href="/case-studies">Case Studies</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <Button href="/contact" variant="primary" class="desktop-cta">Start Consultation</Button>
      <button id="menu-toggle" class="menu-toggle" aria-label="Open menu">
        <span class="hamburger"></span>
      </button>
    </div>
  </div>
</header>
<MobileDrawer />

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(247, 247, 247, 0.9); /* var(--color-bg) with opacity */
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    font-family: var(--font-mono); /* Technical feel */
    font-weight: 700;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: -0.05em;
    z-index: 101; /* Above drawer */
  }

  .desktop-nav {
    display: none;
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-xs);
    z-index: 1001; /* Above drawer */
  }

  .hamburger, .hamburger::before, .hamburger::after {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    transition: transform 0.3s;
  }
  
  .hamburger {
      position: relative;
  }
  
  .hamburger::before, .hamburger::after {
      content: '';
      position: absolute;
  }
  
  .hamburger::before {
      top: -8px;
  }
  
  .hamburger::after {
      top: 8px;
  }

  .desktop-cta {
    display: none;
  }

  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }

    .desktop-nav {
      display: block;
    }

    .desktop-nav ul {
      display: flex;
      gap: var(--space-lg);
      list-style: none;
    }

    .desktop-nav a {
      font-weight: 500;
      font-size: 0.9375rem;
    }

    .desktop-nav a:hover {
      text-decoration: underline;
    }

    .desktop-cta {
      display: inline-flex;
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  
  if (menuToggle) {
    menuToggle.addEventListener('click', () => {
      // Access the global function exposed by MobileDrawer
      if (typeof window.openDrawer === 'function') {
        window.openDrawer();
      }
    });
  }
</script>
