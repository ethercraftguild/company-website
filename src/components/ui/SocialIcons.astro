---
import { SITE_CONFIG } from '../../config';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { socials } = SITE_CONFIG;

// Icon Paths (from public/social-icons/)
const IconPaths: Record<string, string> = {
  linkedin: '/social-icons/linkedin-128.svg',
  facebook: '/social-icons/facebook-128.svg',
  twitter: '/social-icons/x-128.svg', // Mapping Twitter to X icon
  youtube: '/social-icons/youtube-128.svg',
  // Github missing from folder, falling back to inline or could be added later
};

// Inline Fallback for missing files (Github)
const InlineIcons: Record<string, string> = {
  github: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>`
};
---

<div class:list={['social-icons', className]}>
  {Object.entries(socials).map(([key, url]) => {
    if (!url) return null;
    
    // Check for file path first
    const iconPath = IconPaths[key as keyof typeof IconPaths];
    // Check for inline fallback
    const inlineIcon = InlineIcons[key as keyof typeof InlineIcons];

    if (iconPath) {
      return (
        <a href={url} target="_blank" rel="noopener noreferrer" aria-label={key} class="icon-link">
            <img src={iconPath} alt={key} width="20" height="20" class="social-img" />
        </a>
      );
    } 
    
    if (inlineIcon) {
       return (
        <a href={url} target="_blank" rel="noopener noreferrer" aria-label={key} class="icon-link">
            <Fragment set:html={inlineIcon} />
        </a>
      );
    }

    return null;
  })}
</div>

<style>
  .social-icons {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid currentColor;
    color: inherit;
    transition: all var(--transition-fast);
    opacity: 0.8;
  }

  .icon-link:hover {
    opacity: 1;
    background-color: var(--color-text);
    color: var(--color-bg); /* Invert on hover */
    transform: translateY(-2px);
  }
  
  .social-img {
    filter: brightness(0); /* Make black initially to match text */
    transition: filter var(--transition-fast);
  }
  
  .icon-link:hover .social-img {
      filter: invert(1); /* Make white on hover */
  }
</style>
