---
interface Props {
  value: string;
  label: string;
  class?: string;
}

const { value, label, class: className } = Astro.props;
---

<div class:list={['stat-card', className]}>
  <span class="value">{value}</span>
  <span class="label">{label}</span>
</div>

<style>
  .stat-card {
    background-color: var(--color-accent); /* Default dark card */
    color: #F7F7F7;
    padding: var(--space-lg);
    border-radius: var(--radius-sm);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1; /* Force square shape if content fits, or responsive */
    min-height: 200px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: transform 0.3s ease;
  }
  
  .stat-card:hover {
      transform: translateY(-5px);
  }

  .value {
    display: block;
    font-size: 3.5rem; /* Large impact */
    font-weight: 700;
    line-height: 1;
    margin-bottom: var(--space-sm);
    /* Prevent overflow for long numbers */
    overflow-wrap: break-word;
    max-width: 100%; 
  }

  .label {
    font-size: 1rem;
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  /* Responsive Text Sizing */
  @media (max-width: 480px) {
      .value {
          font-size: 2.5rem;
      }
      .stat-card {
          min-height: 160px;
          padding: var(--space-md);
      }
  }
</style>
