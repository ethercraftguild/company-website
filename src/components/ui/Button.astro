---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [x: string]: any;
}

const { href, variant = 'primary', class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn-${variant}`, className]} {...rest}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: all var(--transition-fast);
    font-size: 1rem;
    line-height: 1.5;
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn-primary {
    background-color: var(--color-accent); /* Charcoal */
    color: #F7F7F7; /* Off-white text */
    border-color: var(--color-accent);
  }

  .btn-primary:hover {
    background-color: var(--color-hover); /* Pure Black */
    color: #FFFFFF;
    border-color: var(--color-hover);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-text);
    border-color: var(--color-text);
  }

  .btn-secondary:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }
</style>
